# Response headers, applied by Cloudflare Pages.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# If the site is moved to a host that does not read this file (GitHub Pages, for
# example), these protections are lost — see docs/DEPLOYMENT.md.

/*
  # Stop the site being framed by another site.
  X-Frame-Options: DENY
  # Do not let browsers second-guess declared file types.
  X-Content-Type-Options: nosniff
  # Do not leak the page someone came from to other sites.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site has no need for any of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  #
  # Content security policy. It can be this strict because the site ships almost
  # no JavaScript of its own (ADR-001). If you ever add a script, an embedded
  # video or a web font, it must be allowed here or the browser will block it.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The CMS is an exception: it loads its code from a CDN and talks to GitHub.
/admin/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self' https://api.github.com https://*.workers.dev; frame-ancestors 'none'

# Brochures are permanent, so let browsers keep them for a day.
/brochures/*
  Cache-Control: public, max-age=86400
