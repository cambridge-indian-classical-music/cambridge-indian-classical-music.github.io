# ---------------------------------------------------------------------------
# NOT IN EFFECT. Read this before trusting anything below.
#
# This file sets response headers on hosts that read it — Cloudflare Pages and
# Netlify do; GITHUB PAGES DOES NOT. The site is currently on GitHub Pages
# (ADR-007), so NONE of the protections below are being applied to the live
# site. Nothing breaks visibly, which is exactly why it is written here.
#
# The file is kept rather than deleted for two reasons: it is the record of what
# the policy should be, and it starts working again the moment the site moves to
# a host that reads it — no re-derivation needed.
#
# What this costs today, and what to do about it, is in docs/DEPLOYMENT.md
# ("Security headers on GitHub Pages"). If you add a script or an embedded video
# to the site, still update this file, so that the record stays accurate.
#
# Format: https://developers.cloudflare.com/pages/configuration/headers/
# ---------------------------------------------------------------------------

/*
  # Stop the site being framed by another site.
  X-Frame-Options: DENY
  # Do not let browsers second-guess declared file types.
  X-Content-Type-Options: nosniff
  # Do not leak the page someone came from to other sites.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site has no need for any of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  #
  # Content security policy. It can be this strict because the site ships almost
  # no JavaScript of its own (ADR-001). If you ever add a script, an embedded
  # video or a web font, it must be allowed here or the browser will block it.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The CMS is an exception: it loads its code from a CDN and talks to GitHub.
/admin/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self' https://api.github.com https://*.workers.dev; frame-ancestors 'none'

# Brochures are permanent, so let browsers keep them for a day.
/brochures/*
  Cache-Control: public, max-age=86400
