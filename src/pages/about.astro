---
/**
 * About the society, plus the current committee.
 *
 * The prose comes from src/content/pages/about.md and the committee from
 * src/content/committee.yml, so both can be updated without touching this file.
 */
import { getEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const page = await getEntry('pages', 'about');
if (!page) {
  // A clear failure at build time beats a mysteriously empty page in production.
  throw new Error('Missing src/content/pages/about.md — the About page needs it.');
}

const { Content } = await render(page);
// Sorted by the `order` field: Astro does not keep the order of entries in
// committee.yml, so without this the committee would appear sorted by id.
const committee = (await getCollection('committee')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="container">
    <header class="page-head">
      <h1>{page.data.title}</h1>
    </header>

    <div class="prose">
      <Content />
    </div>

    {committee.length > 0 && (
      <section class="committee">
        <h2>The committee</h2>
        <ul class="committee__list" role="list">
          {committee.map((member) => (
            <li class:list={['committee__member', { 'committee__member--larger': member.data.larger }]}>
              {member.data.photo ? (
                <Image
                  class="committee__photo"
                  src={member.data.photo.src}
                  alt={member.data.photo.alt}
                  width={320}
                  height={320}
                  widths={[240, 320, 480]}
                  sizes="(min-width: 40em) 16rem, 100vw"
                  loading="lazy"
                />
              ) : (
                /* No photo yet: an empty frame of the same size keeps the row even. */
                <div class="committee__photo committee__photo--empty" aria-hidden="true" />
              )}
              <p class="committee__name">{member.data.name}</p>
              <p class="committee__role">{member.data.role}</p>
              {member.data.note && <p class="committee__note">{member.data.note}</p>}
              {member.data.email && (
                <p class="committee__email">
                  <a href={`mailto:${member.data.email}`}>{member.data.email}</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="contact">
      <h2>Get in touch</h2>
      <p>
        Email us at <a href={`mailto:${site.email}`}>{site.email}</a>. We are always glad to hear from people
        who want to listen, perform or help out.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-12) var(--space-8);
  }

  .committee,
  .contact {
    margin-block-start: var(--space-16);
  }

  .committee h2,
  .contact h2 {
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }

  /* A wrapping row rather than a grid, so that one member can be wider than the
     rest (`larger: true` in committee.yml). Items are aligned at the bottom so
     the names still sit in a line under a bigger photo. */
  .committee__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-12) var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .committee__member {
    width: min(13rem, 100%);
  }

  /* 20% bigger: 13rem × 1.2. */
  .committee__member--larger {
    width: min(15.6rem, 100%);
  }

  /* Photo on top, name and role underneath. */
  .committee__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    margin-block-end: var(--space-4);
  }

  .committee__photo--empty {
    background: var(--surface);
  }

  .committee__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .committee__note {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--ink-muted);
  }

  .committee__role,
  .committee__email {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
