---
/**
 * A single artist, with their biography and the events they have been part of.
 *
 * The event list is worked out from the events themselves, so nobody has to keep
 * an artist's page in step by hand — booking someone for a concert adds them to
 * their page automatically.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventGrid from '../../components/EventGrid.astro';
import { getArtists, getEvents } from '../../lib/events';
import { toInstant } from '../../lib/datetime';

export async function getStaticPaths() {
  const artists = await getArtists();
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}

// No `interface Props` is needed here: getStaticPaths above already types
// Astro.props. Components that receive props from a parent do declare one.
const { artist } = Astro.props;
const { name, discipline, tradition, summary, image, links } = artist.data;
const { Content } = await render(artist);

const appearances = (await getEvents())
  .filter((event) => event.data.people.some((person) => person.artist.id === artist.id))
  .sort((a, b) => toInstant(b.data.start).getTime() - toInstant(a.data.start).getTime());

const TRADITION_LABELS = {
  carnatic: 'Carnatic tradition',
  hindustani: 'Hindustani tradition',
  both: 'Carnatic and Hindustani traditions',
  other: '',
} as const;
---

<BaseLayout title={name} description={summary} ogType="article">
  <article class="container artist">
    <header class="artist__head">
      {image && <Image class="artist__photo" src={image.src} alt={image.alt} width={280} height={280} />}
      <div>
        <p class="eyebrow">{discipline}</p>
        <h1>{name}</h1>
        <p class="artist__summary">{summary}</p>
        {TRADITION_LABELS[tradition] && <p class="artist__tradition">{TRADITION_LABELS[tradition]}</p>}

        {
          links.length > 0 && (
            <ul class="artist__links" role="list">
              {links.map((link) => (
                <li>
                  <a href={link.url} rel="noopener noreferrer">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="prose artist__bio">
      <Content />
    </div>

    {
      appearances.length > 0 && (
        <section class="artist__events">
          <h2>With the society</h2>
          <EventGrid events={appearances} headingLevel="h3" />
        </section>
      )
    }

    <p class="artist__back"><a href="/artists">← All artists</a></p>
  </article>
</BaseLayout>

<style>
  .artist {
    padding-block-start: var(--space-12);
  }

  .artist__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: start;
  }

  .artist__photo {
    width: 12rem;
    height: 12rem;
    flex: none;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .artist__summary {
    margin-block-start: var(--space-4);
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .artist__tradition {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .artist__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .artist__bio {
    margin-block-start: var(--space-12);
  }

  .artist__events {
    margin-block-start: var(--space-16);
  }

  .artist__events h2 {
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }

  .artist__back {
    margin-block-start: var(--space-16);
  }
</style>
