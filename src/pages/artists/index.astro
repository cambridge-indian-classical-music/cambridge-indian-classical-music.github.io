---
/**
 * Everyone who has performed or taught for the society.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArtists } from '../../lib/events';

const artists = await getArtists();

const TRADITION_LABELS = {
  carnatic: 'Carnatic',
  hindustani: 'Hindustani',
  both: 'Carnatic & Hindustani',
  other: '',
} as const;
---

<BaseLayout
  title="Artists"
  description="Musicians who have performed and taught for the Cambridge University Indian Classical Music Society."
>
  <div class="container">
    <header class="page-head">
      <h1>Artists</h1>
      <p class="page-head__lede">
        The musicians who have performed and taught for the society, in both the Carnatic and Hindustani
        traditions.
      </p>
    </header>

    {artists.length > 0 ? (
      <ul class="artists" role="list">
        {artists.map((artist) => (
          <li class="artist">
            {artist.data.image && (
              <Image
                class="artist__photo"
                src={artist.data.image.src}
                alt=""
                width={200}
                height={200}
                loading="lazy"
              />
            )}
            <div>
              <h2 class="artist__name">
                <a href={`/artists/${artist.id}`}>{artist.data.name}</a>
              </h2>
              <p class="artist__meta">
                {artist.data.discipline}
                {TRADITION_LABELS[artist.data.tradition] && ` · ${TRADITION_LABELS[artist.data.tradition]}`}
              </p>
              <p class="artist__summary">{artist.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No artists have been added yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-12) var(--space-8);
    max-width: var(--measure);
  }

  .page-head__lede {
    margin-block-start: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--text-lg);
  }

  .artists {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .artist {
    display: flex;
    gap: var(--space-4);
    align-items: start;
  }

  .artist__photo {
    width: 5rem;
    height: 5rem;
    flex: none;
    object-fit: cover;
    border-radius: 50%;
  }

  .artist__name {
    font-size: var(--text-lg);
  }

  .artist__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .artist__name a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .artist__meta {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .artist__summary {
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
  }

  .empty {
    color: var(--ink-muted);
  }
</style>
