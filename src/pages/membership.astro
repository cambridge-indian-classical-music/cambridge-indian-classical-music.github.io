---
/**
 * Society membership.
 *
 * Membership is its own collection, not an event (see ADR-003 and
 * docs/TICKETING.md): it runs for over a year, has no venue, and would sit at
 * the top of the events list until it expired.
 *
 * This page sells the membership; /membership/join collects the application.
 * Neither takes a payment. The joining form hands over to the payment
 * provider's own page, exactly as concert tickets do (ADR-006, ADR-012).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, formatTime, toMachineDateTime } from '../lib/datetime';
import { site } from '../site.config';

/**
 * The membership currently on offer.
 *
 * One file per year, newest first. A committee preparing next year's membership
 * early should mark it `draft: true` until it opens, or it will be shown here
 * before it is real.
 */
const published = (await getCollection('membership')).filter(
  (entry) => import.meta.env.DEV || !entry.data.draft,
);
const current = published.sort((a, b) => b.data.opens.localeCompare(a.data.opens))[0];

if (!current) {
  // A clear failure at build time beats a mysteriously empty page in production.
  throw new Error('No membership found. Add a file to src/content/membership/ — see docs/CONTENT_GUIDE.md.');
}

const { title, summary, rates, opens, closes, formEndpoint, benefits } = current.data;

/**
 * The joining form previews locally before it can actually work, so that the
 * committee can read the questions over — see the note in membership/join.astro.
 * This page has to agree with it, or `npm run dev` shows a form nobody can
 * navigate to. `import.meta.env.DEV` is false in every build, so the published
 * page still says "joining opens shortly" until `formEndpoint` is set.
 */
const isPreview = !formEndpoint && import.meta.env.DEV;
const canJoin = Boolean(formEndpoint) || isPreview;
const { Content } = await render(current);
---

<BaseLayout title={title} description={summary}>
  <div class="container">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <dl class="facts">
      <div>
        <dt>Valid from</dt>
        <dd>
          <time datetime={toMachineDateTime(opens)}>
            {formatDate(opens)}, {formatTime(opens)}
          </time>
        </dd>
      </div>
      <div>
        <dt>Valid until</dt>
        <dd>
          <time datetime={toMachineDateTime(closes)}>
            {formatDate(closes)}, {formatTime(closes)}
          </time>
        </dd>
      </div>
    </dl>

    <section class="rates">
      <h2>Which rate you pay</h2>
      <dl>
        <div>
          <dt>{rates.student.price} — Student</dt>
          <dd>{rates.student.note}</dd>
        </div>
        <div>
          <dt>{rates.general.price} — General</dt>
          <dd>{rates.general.note}</dd>
        </div>
      </dl>
    </section>

    <section class="includes">
      <h2>What membership includes</h2>
      <ul role="list">
        {benefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
    </section>

    <section class="join">
      {
        canJoin ? (
          <>
            <a class="button" href="/membership/join">
              Join the Society
            </a>
            <p class="join__note">
              {isPreview ? (
                <strong>Preview only — this link works locally, not on the published site.</strong>
              ) : (
                <>
                  We ask a few questions first, then send you to our payment provider's own secure page. This
                  website never sees your card details.
                </>
              )}
            </p>
          </>
        ) : (
          <p class="join__note">
            <strong>Joining opens shortly.</strong> The form will appear here once it is ready — in the
            meantime, email <a href={`mailto:${site.email}`}>{site.email}</a> and we will let you know.
          </p>
        )
      }
    </section>

    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-12) var(--space-8);
  }

  .lede {
    margin-block-start: var(--space-3);
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: 48ch;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
    padding-block: var(--space-6);
    border-block: 1px solid var(--rule);
  }

  .facts dt {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0;
    margin-block-start: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .rates {
    margin-block-start: var(--space-10);
  }

  .rates h2 {
    margin-block-end: var(--space-4);
  }

  .rates dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-6);
    margin: 0;
  }

  .rates dt {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .rates dd {
    margin: 0;
    margin-block-start: var(--space-1);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .includes {
    margin-block-start: var(--space-10);
  }

  .includes h2 {
    margin-block-end: var(--space-4);
  }

  .includes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  /* A marker that does not depend on list-style, so it survives role="list". */
  .includes li {
    padding-inline-start: var(--space-6);
    position: relative;
  }

  .includes li::before {
    content: '\2014';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }

  .join {
    margin-block-start: var(--space-10);
  }

  .join__note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .prose {
    margin-block-start: var(--space-12);
  }
</style>
