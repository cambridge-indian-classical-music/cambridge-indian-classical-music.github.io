---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="container notfound">
    <h1>Page not found</h1>
    <p>
      That page does not exist — it may have moved, or a past event may have been renamed. Try the
      <a href="/events">events listing</a> or the <a href="/">homepage</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-24);
    max-width: var(--measure);
  }

  .notfound p {
    margin-block-start: var(--space-4);
    color: var(--ink-muted);
  }
</style>
