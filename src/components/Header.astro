---
/**
 * Site header and main navigation.
 *
 * The navigation is plain links with no JavaScript: it works before the page has
 * finished loading, works with JavaScript disabled, and cannot break. On narrow
 * screens the links wrap rather than collapsing into a menu button — with only
 * three items, a hamburger menu would hide them for no benefit.
 *
 * To change the links, edit `nav` in src/site.config.ts.
 *
 * The brand is the society's logo image, which already spells out "CU ICM" and
 * the full name — so there is no separate text beside it. Its alt text is the
 * full name, which is what a screen reader should announce. To replace the
 * logo, overwrite src/assets/images/cuicm-logo.png (a PNG with a transparent
 * background, cropped tight to the artwork).
 */
import { Image } from 'astro:assets';
import { site } from '../site.config';
import logo from '../assets/images/cuicm-logo.png';

const path = Astro.url.pathname;
/** A section counts as current when you are on it or on a page inside it. */
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/">
      <Image class="header__logo" src={logo} alt={site.name} height={64} densities={[1, 2]} loading="eager" />
    </a>

    <nav aria-label="Main">
      <ul class="header__nav">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['header__link', { 'header__link--current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-block-end: 1px solid var(--rule);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-6);
  }

  .header__brand {
    display: block;
    line-height: 0;
  }

  /* Height-led so the logo keeps its proportions; capped by width so it never
     pushes the page sideways on a narrow phone. */
  .header__logo {
    display: block;
    height: 3rem;
    width: auto;
    max-width: 100%;
  }

  @media (min-width: 40em) {
    .header__logo {
      height: 4rem;
    }
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    padding-block: var(--space-1);
    border-block-end: 2px solid transparent;
  }

  .header__link:hover {
    color: var(--accent);
    border-block-end-color: var(--rule);
  }

  /* The current section is marked with a colour AND an underline, so it is not
     signalled by colour alone. */
  .header__link--current {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }
</style>
