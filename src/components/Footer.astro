---
/**
 * Site footer. Contact details and social links come from src/site.config.ts.
 */
import { site } from '../site.config';

// Built as one string: splitting `{year}` and `{site.name}` across two lines
// makes the whitespace between them disappear in the output.
const copyright = `© ${new Date().getFullYear()} ${site.name}.`;
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__name">{site.name}</p>
      <p class="footer__muted">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    {site.social.length > 0 && (
      <nav aria-label="Social media">
        <ul class="footer__social">
          {site.social.map((item) => (
            <li>
              {/* rel="noopener noreferrer" on every outbound link — see ARCHITECTURE.md */}
              <a href={item.href} rel="noopener noreferrer">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <div class="container">
    <p class="footer__muted footer__legal">
      {copyright} A society of the University of Cambridge Students' Union.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-24);
    padding-block: var(--space-12);
    border-block-start: 1px solid var(--rule);
    background: var(--surface);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .footer__muted {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__legal {
    margin-block-start: var(--space-8);
  }
</style>
